# Configuración Local de OTI-PayAgent (Django 5 + Hermes Agent / LLM Fallback)
DJANGO_DEBUG=True

# 1. Conector Primario: Hermes Agent (openai-codex OAuth en cola FIFO = 1 informe a la vez)
HERMES_BASE_URL=http://127.0.0.1:8080/v1
HERMES_API_KEY=hermes-oauth-codex
HERMES_MODEL=gpt-4o

# 2. Fallbacks Automáticos por API Key (Opcionales - si están vacíos usa el Modo Demo/Offline Inteligente OTI-URT)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
